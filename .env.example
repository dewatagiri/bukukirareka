# Copy this file to .env and fill in.
TELEGRAM_BOT_TOKEN=123456789:ABCdef...        # from @BotFather
GEMINI_API_KEY=AIza...                         # from aistudio.google.com
GEMINI_MODEL=gemini-3.8-flash                  # cheaper option: gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite    # used if the main model stays busy (503); optional
SHEET_ID=1AbC...xyz                            # the long ID in the Google Sheet URL
GOOGLE_CREDS_JSON=service_account.json         # service-account key file in this folder
ALLOWED_USER_IDS=111111111,222222222           # wife's Telegram ID (and yours), comma-separated
TIMEZONE=Asia/Kuala_Lumpur
WEEKLY_REPORT_DAY=0                            # 0=Sunday, 1=Monday ... 6=Saturday
WEEKLY_REPORT_TIME=21:00
DEBT_REMINDER_DAYS=7                           # nudge her about a debt at 7, 14, 21... days old; 0 = off
DEBT_REMINDER_TIME=10:00
STATE_FILE=bukukira_state.pickle               # keeps unconfirmed entries across restarts
